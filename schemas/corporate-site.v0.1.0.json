{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "project_id",
    "locale",
    "route",
    "source_id",
    "brand",
    "sections",
    "plans",
    "services",
    "behaviors",
    "assets",
    "pending_decisions",
    "acceptance"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "nexonova.corporate-site.v0.1.0"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "[a-z0-9][a-z0-9-]{0,62}"
    },
    "locale": {
      "type": "string",
      "enum": [
        "es-CL"
      ]
    },
    "route": {
      "type": "string",
      "enum": [
        "/"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "[a-z0-9][a-z0-9-]{0,62}"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "colors",
        "font_family",
        "font_approval"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "navy",
            "blue",
            "cyan"
          ],
          "properties": {
            "navy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "blue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "cyan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "font_approval": {
          "type": "string",
          "enum": [
            "approved",
            "pending"
          ]
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "header",
              "hero",
              "domains",
              "about",
              "plans",
              "services",
              "faq",
              "contact",
              "footer",
              "chat",
              "inquiry"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "price_clp",
          "demonstration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[a-z0-9][a-z0-9-]{0,62}"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "price_clp": {
            "type": "integer",
            "minimum": 0
          },
          "demonstration": {
            "type": "string",
            "enum": [
              "provisional"
            ]
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "behaviors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "chat",
        "inquiry",
        "contact",
        "persistence",
        "external_requests"
      ],
      "properties": {
        "domains": {
          "type": "string",
          "enum": [
            "local-format-only"
          ]
        },
        "chat": {
          "type": "string",
          "enum": [
            "local-scripted"
          ]
        },
        "inquiry": {
          "type": "string",
          "enum": [
            "interest-summary"
          ]
        },
        "contact": {
          "type": "string",
          "enum": [
            "prepare-copy-not-sent"
          ]
        },
        "persistence": {
          "type": "string",
          "enum": [
            "memory-only"
          ]
        },
        "external_requests": {
          "type": "string",
          "enum": [
            "disabled"
          ]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "approval"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "pattern": "[a-z0-9][a-z0-9-]{0,62}"
          },
          "approval": {
            "type": "string",
            "enum": [
              "approved",
              "pending"
            ]
          }
        }
      }
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
