{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_id",
    "tree_hash",
    "authorization",
    "entries",
    "missing",
    "pending_decisions"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "nexonova.source-manifest.v1"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "[a-z0-9][a-z0-9-]{0,62}"
    },
    "tree_hash": {
      "type": "string",
      "pattern": "sha256:[a-f0-9]{64}"
    },
    "authorization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "action",
          "reason",
          "approval",
          "target"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "sha256:[a-f0-9]{64}"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "KEEP",
              "ADAPT",
              "REBUILD",
              "DROP",
              "REVIEW"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "approval": {
            "type": "string",
            "enum": [
              "approved",
              "pending",
              "not_selected"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}
